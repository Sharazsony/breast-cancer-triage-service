# Copy to .env and adjust. The real .env is git-ignored and must never be committed.

# Docker Hub namespace and tag used to name the api image (<user>/breast-cancer-triage-api:<tag>)
DOCKERHUB_USERNAME=sharaz123
IMAGE_TAG=1.0.0

# Build arguments baked into the image and exposed via /model/info.
# GIT_SHA is best passed from the shell: GIT_SHA=$(git rev-parse --short HEAD) docker compose ...
MODEL_VERSION=1.0.0
GIT_SHA=unknown

# Host port that maps to the api container port 8000
API_PORT=8000

# Runtime configuration of the api service
DECISION_THRESHOLD=0.5
LOG_LEVEL=INFO
