# Baseline image in the style of the lecture demo: big base, everything in one
# context copy, dependencies reinstalled whenever any file changes.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y python3 python3-pip

WORKDIR /app
COPY . .

RUN pip3 install --break-system-packages --ignore-installed -r requirements-train.txt -r requirements-serve.txt
RUN python3 -m training.train --data-path data/raw/breast_cancer.csv --output-dir artifacts --model-version 1.0.0

EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
